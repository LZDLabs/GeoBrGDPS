diff --git a/src/compat/Geode6Compat.hpp b/src/compat/Geode6Compat.hpp
new file mode 100644
index 0000000..9c8ff67
--- /dev/null
+++ b/src/compat/Geode6Compat.hpp
@@ -0,0 +1,19 @@
+#pragma once
+// GD 2.2091 / Geode 6 build of GeoBR 1.15.3 (no Natal content).
+// GD 2.2091 uses std::string everywhere (gd::string is gone) and Geode 6
+// paths are asp::fs::Path; these two helpers keep the 1.15.3 code as it was.
+#include <string>
+#include <filesystem>
+#include <asp/fs/std.hpp>
+
+namespace gd { using string = std::string; }
+
+namespace geobr6 {
+inline std::filesystem::path stdp(asp::fs::PathView p) { return std::filesystem::path(p.native()); }
+inline asp::fs::Path aspp(std::filesystem::path const& p) { return asp::fs::Path::fromStdPath(p); }
+} // namespace geobr6
+
+namespace geobr6 {
+inline std::string pathStr(std::filesystem::path const& p) { return p.string(); }
+inline std::string pathStr(asp::fs::PathView p) { return std::string(p.string()); }
+} // namespace geobr6
diff --git a/src/compat/LocalGmd.hpp b/src/compat/LocalGmd.hpp
new file mode 100644
index 0000000..a1fa8f1
--- /dev/null
+++ b/src/compat/LocalGmd.hpp
@@ -0,0 +1,59 @@
+#pragma once
+// GD 2.2091 build: the GMD API mod has no Geode 6 release yet, so the few
+// .gmd calls GeoBR makes (plain .gmd only) are done here with GD's own
+// DS_Dictionary, the same coder the game uses for its save files.
+#include <Geode/Geode.hpp>
+#include <filesystem>
+#include <memory>
+#include <string>
+
+namespace gmd {
+
+enum class GmdFileType { Gmd };
+
+namespace detail {
+inline void preparePlist(std::string& data) {
+    for (auto& c : data) if (!c) c = ' ';
+    auto head = data.substr(0, 100);
+    if (auto at = head.find("<plist version=\"1.0\">"); at != std::string::npos)
+        data.replace(at, 21, "<plist version=\"1.0\" gjver=\"2.0\">");
+    if (data.starts_with("<?xml version")) return;
+    if (data.substr(0, 100).find("<plist version") == std::string::npos)
+        data = "<?xml version=\"1.0\"?><plist version=\"1.0\" gjver=\"2.0\"><dict><k>root</k>" + data + "</dict></plist>";
+    else
+        data = "<?xml version=\"1.0\"?>" + data;
+}
+} // namespace detail
+
+inline geode::Result<GJGameLevel*> importGmdAsLevel(std::filesystem::path const& from) {
+    auto text = geode::utils::file::readString(geobr6::aspp(from));
+    if (text.isErr()) return geode::Err("Nao foi possivel ler o arquivo");
+    auto data = text.unwrap();
+    detail::preparePlist(data);
+    auto dict = std::make_unique<DS_Dictionary>();
+    if (!dict->loadRootSubDictFromString(data)) return geode::Err("Arquivo .gmd invalido");
+    dict->stepIntoSubDictWithKey("root");
+    auto level = GJGameLevel::create();
+    level->dataLoaded(dict.get());
+    level->m_isEditable = true;
+    level->m_levelType = GJLevelType::Editor;
+    level->m_stars = 0;
+    level->m_demon = 0;
+    level->m_dailyID = 0;
+    level->m_gauntletLevel = false;
+    level->m_gauntletLevel2 = false;
+    if (level->m_levelString.empty()) level->m_levelString = dict->getStringForKey("k4");
+    return geode::Ok(level);
+}
+
+inline geode::Result<> exportLevelAsGmd(GJGameLevel* level, std::filesystem::path const& to, GmdFileType = GmdFileType::Gmd) {
+    if (!level) return geode::Err("Fase vazia");
+    auto dict = std::make_unique<DS_Dictionary>();
+    level->encodeWithCoder(dict.get());
+    std::string data = dict->saveRootSubDictToString();
+    if (auto written = geode::utils::file::writeString(geobr6::aspp(to), data); written.isErr())
+        return geode::Err("Nao foi possivel salvar o arquivo");
+    return geode::Ok();
+}
+
+} // namespace gmd
